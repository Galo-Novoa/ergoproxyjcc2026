# Copiá este archivo a .env.local y completá los valores.

# Requerido: secreto de sesión de Better Auth.
# Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Sin DATABASE_URL la app corre en modo demo (memoria, sin persistencia).
# Con valor, usa Postgres: DATABASE_URL es la conexión con pooler y
# DATABASE_URL_UNPOOLED la directa que usan las migraciones.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Opcional: proveedor de LLM del chat. Con OPENCODE_API_KEY usa OpenCode Zen;
# sin ella, el AI Gateway de Vercel. LLM_MODEL sobreescribe el modelo por defecto.
OPENCODE_API_KEY=
LLM_MODEL=
