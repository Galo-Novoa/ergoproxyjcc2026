generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Autenticación (Better Auth) -------------------------------------------
// Los nombres de tabla y columna son los que espera Better Auth: no renombrar.

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @default(now()) @db.Timestamp(6)

  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  subjects      Subject[]
  files         File[]
  documents     Document[]
  conversations Conversation[]
  messages      Message[]
  questionNodes QuestionNode[]
  conversationFiles ConversationFile[]
  agentActions  AgentAction[]
  folderNodes   FolderNode[]
  folderEdges   FolderEdge[]
  folderRefs    FolderNodeRef[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamp(6)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "session_user_idx")
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamp(6)
  refreshTokenExpiresAt DateTime? @db.Timestamp(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamp(6)
  updatedAt             DateTime  @default(now()) @db.Timestamp(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "account_user_idx")
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @db.Timestamp(6)
  createdAt  DateTime? @default(now()) @db.Timestamp(6)
  updatedAt  DateTime? @default(now()) @db.Timestamp(6)

  @@map("verification")
}

// --- Ámbito institucional --------------------------------------------------
// Una organización (por ejemplo, una facultad) puede administrar recursos
// compartidos. Hoy ninguna pantalla crea organizaciones: el modelo y las reglas
// de acceso (lib/authz.ts) quedan listos para una instalación institucional.
// Un recurso con visibility = 'private' es solo de su dueño, siempre.

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)

  memberships Membership[]
  subjects    Subject[]
  files       File[]
  documents   Document[]

  @@map("organizations")
}

// role: 'admin' (administra recursos compartidos) | 'member' (solo lectura de lo compartido)
model Membership {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  userId         String
  role           String       @default("member")
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId], map: "memberships_org_user_key")
  @@index([userId], map: "memberships_user_idx")
  @@map("memberships")
}

// --- Dominio académico -----------------------------------------------------
// Todo registro tiene dueño (`userId`, con FK). Subject, File y Document pueden
// además pertenecer a una organización con visibility = 'organization'.
// Un File/Document con subjectId = NULL pertenece al workspace General.

model Subject {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String
  organizationId String?       @db.Uuid
  visibility     String        @default("private")
  name           String
  code           String?
  description    String?
  color          String        @default("azul")
  icon           String        @default("book-open")
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamp(6)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  files         File[]
  documents     Document[]
  conversations Conversation[]
  questionNodes QuestionNode[]
  folderNodes   FolderNode[]

  @@index([userId], map: "subjects_user_idx")
  @@index([organizationId], map: "subjects_org_idx")
  @@map("subjects")
}

model File {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String
  organizationId String?       @db.Uuid
  visibility     String        @default("private")
  subjectId      String?       @db.Uuid
  name           String
  mimeType       String
  sizeBytes      Int           @default(0)
  storageUrl     String?
  status         String        @default("pending")
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  subject        Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  documents         Document[]
  conversationLinks ConversationFile[]
  questionNodes     QuestionNode[]

  @@index([userId], map: "files_user_idx")
  @@index([subjectId], map: "files_subject_idx")
  @@index([organizationId], map: "files_org_idx")
  @@map("files")
}

// kind: 'note' | 'summary' | 'source' (texto extraído de un archivo subido)
model Document {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String
  organizationId String?       @db.Uuid
  visibility     String        @default("private")
  subjectId      String?       @db.Uuid
  sourceFileId   String?       @db.Uuid
  title          String
  kind           String        @default("note")
  contentMd      String        @default("")
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamp(6)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  subject        Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  sourceFile     File?         @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)

  @@index([userId], map: "documents_user_idx")
  @@index([subjectId], map: "documents_subject_idx")
  @@index([organizationId], map: "documents_org_idx")
  @@map("documents")
}

// Las conversaciones y sus mensajes son siempre privados de su dueño.
// mode: 'theory' | 'practice' | 'free'
model Conversation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  subjectId String?  @db.Uuid
  title     String   @default("Nueva conversación")
  mode      String   @default("free")
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  messages      Message[]
  fileLinks     ConversationFile[]
  questionNodes QuestionNode[]
  agentActions  AgentAction[]
  folderRefs    FolderNodeRef[]

  @@index([userId], map: "conversations_user_idx")
  @@index([subjectId], map: "conversations_subject_idx")
  @@map("conversations")
}

model ConversationFile {
  conversationId String       @db.Uuid
  fileId         String       @db.Uuid
  userId         String
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  file           File         @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, fileId])
  @@index([userId], map: "conversation_files_user_idx")
  @@map("conversation_files")
}

// role: 'user' | 'assistant' | 'system'
// content: texto visible (Markdown). description: alias corto del tema (solo asistente).
// metadata: datos estructurados de la respuesta (modelo, recuperación, acciones descartadas).
model Message {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @db.Uuid
  userId         String
  role           String
  content        String
  description    String?
  metadata       Json?
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  questionNodes QuestionNode[]
  agentActions  AgentAction[]
  folderRefs    FolderNodeRef[]

  @@index([conversationId], map: "messages_conversation_idx")
  @@index([userId], map: "messages_user_idx")
  @@map("messages")
}

// Acciones que el agente PROPONE. Nunca se ejecutan solas: pasan a 'accepted'
// únicamente cuando el usuario las confirma y el backend las revalida.
// type: 'propose_history_branch' | 'propose_folder_change' · status: 'proposed' | 'accepted' | 'dismissed'
model AgentAction {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String
  conversationId String       @db.Uuid
  messageId      String       @db.Uuid
  type           String
  payload        Json
  status         String       @default("proposed")
  resultNodeId   String?      @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  resolvedAt     DateTime?    @db.Timestamp(6)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId], map: "agent_actions_user_idx")
  @@index([conversationId], map: "agent_actions_conversation_idx")
  @@index([messageId], map: "agent_actions_message_idx")
  @@map("agent_actions")
}

// Nodos del mapa conceptual: cada duda es un nodo; `parentId` arma el árbol.
// status: 'open' | 'resolved'
model QuestionNode {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String
  subjectId      String?       @db.Uuid
  conversationId String?       @db.Uuid
  messageId      String?       @db.Uuid
  fileId         String?       @db.Uuid
  parentId       String?       @db.Uuid
  question       String
  answerSummary  String?
  status         String        @default("open")
  posX           Float         @default(0) @db.Real
  posY           Float         @default(0) @db.Real
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamp(6)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject        Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  file           File?         @relation(fields: [fileId], references: [id], onDelete: SetNull)
  parent         QuestionNode? @relation("QuestionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       QuestionNode[] @relation("QuestionTree")
  folderRefs     FolderNodeRef[]

  @@index([userId], map: "question_nodes_user_idx")
  @@index([subjectId], map: "question_nodes_subject_idx")
  @@index([parentId], map: "question_nodes_parent_idx")
  @@map("question_nodes")
}

// --- Carpeta: grafo de conocimiento de la materia ----------------------------
// Es independiente del historial de dudas: un concepto se estudia una vez y
// puede recibir referencias desde muchas sesiones. No hay conversión automática
// entre QuestionNode y FolderNode; se vinculan con FolderNodeRef.

// type: 'concept' | 'key_points' | 'exercise' | 'solution' | 'note'
// origin: 'ai' | 'manual' — lo tocado a mano sobrevive a una regeneración.
model FolderNode {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  subjectId String   @db.Uuid
  title     String
  type      String   @default("concept")
  contentMd String   @default("")
  posX      Float    @default(0) @db.Real
  posY      Float    @default(0) @db.Real
  origin    String   @default("manual")
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  edgesFrom  FolderEdge[]     @relation("FolderEdgeFrom")
  edgesTo    FolderEdge[]     @relation("FolderEdgeTo")
  references FolderNodeRef[]

  @@index([userId], map: "folder_nodes_user_idx")
  @@index([subjectId], map: "folder_nodes_subject_idx")
  @@map("folder_nodes")
}

// Relación entre dos apuntes. El grafo no es un árbol: un nodo puede tener
// varios padres y relaciones laterales.
// kind: 'relates' | 'contains' | 'solves'
model FolderEdge {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  fromId    String   @db.Uuid
  toId      String   @db.Uuid
  kind      String   @default("relates")
  createdAt DateTime @default(now()) @db.Timestamp(6)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  from      FolderNode @relation("FolderEdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        FolderNode @relation("FolderEdgeTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, kind], map: "folder_edges_unique")
  @@index([userId], map: "folder_edges_user_idx")
  @@index([toId], map: "folder_edges_to_idx")
  @@map("folder_edges")
}

// De dónde salió un apunte: la sesión, el mensaje o la duda que lo justifican.
// Todos opcionales: una nota escrita a mano no referencia nada.
model FolderNodeRef {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String
  nodeId         String   @db.Uuid
  conversationId String?  @db.Uuid
  messageId      String?  @db.Uuid
  questionNodeId String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamp(6)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  node           FolderNode    @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  questionNode   QuestionNode? @relation(fields: [questionNodeId], references: [id], onDelete: SetNull)

  @@index([userId], map: "folder_node_refs_user_idx")
  @@index([nodeId], map: "folder_node_refs_node_idx")
  @@map("folder_node_refs")
}
