generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Autenticación (Better Auth) -------------------------------------------
// Los nombres de tabla y columna son los que espera Better Auth: no renombrar.

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @default(now()) @db.Timestamp(6)

  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  subjects      Subject[]
  files         File[]
  filePages     FilePage[]
  fileChunks    FileChunk[]
  documents     Document[]
  conversations Conversation[]
  messages      Message[]
  questionNodes QuestionNode[]
  conversationFiles ConversationFile[]
  agentActions  AgentAction[]
  conversationNodes ConversationNode[]
  folderNodes   FolderNode[]
  folderEdges   FolderEdge[]
  folderSources FolderSource[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamp(6)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @db.Timestamp(6)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "session_user_idx")
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamp(6)
  refreshTokenExpiresAt DateTime? @db.Timestamp(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamp(6)
  updatedAt             DateTime  @default(now()) @db.Timestamp(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "account_user_idx")
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @db.Timestamp(6)
  createdAt  DateTime? @default(now()) @db.Timestamp(6)
  updatedAt  DateTime? @default(now()) @db.Timestamp(6)

  @@map("verification")
}

// --- Ámbito institucional --------------------------------------------------
// Una organización (por ejemplo, una facultad) puede administrar recursos
// compartidos. Hoy ninguna pantalla crea organizaciones: el modelo y las reglas
// de acceso (lib/authz.ts) quedan listos para una instalación institucional.
// Un recurso con visibility = 'private' es solo de su dueño, siempre.

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)

  memberships Membership[]
  subjects    Subject[]
  files       File[]
  documents   Document[]

  @@map("organizations")
}

// role: 'admin' (administra recursos compartidos) | 'member' (solo lectura de lo compartido)
model Membership {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  userId         String
  role           String       @default("member")
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId], map: "memberships_org_user_key")
  @@index([userId], map: "memberships_user_idx")
  @@map("memberships")
}

// --- Dominio académico -----------------------------------------------------
// Todo registro tiene dueño (`userId`, con FK). Subject, File y Document pueden
// además pertenecer a una organización con visibility = 'organization'.
// Un File/Document con subjectId = NULL pertenece al workspace General.

model Subject {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String
  organizationId String?       @db.Uuid
  visibility     String        @default("private")
  name           String
  code           String?
  description    String?
  color          String        @default("azul")
  icon           String        @default("book-open")
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamp(6)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  files         File[]
  documents     Document[]
  conversations Conversation[]
  questionNodes QuestionNode[]
  folderNodes   FolderNode[]

  @@index([userId], map: "subjects_user_idx")
  @@index([organizationId], map: "subjects_org_idx")
  @@map("subjects")
}

// Archivo subido (PDF). El binario vive en Vercel Blob (privado); acá solo hay metadatos.
// status: 'uploading' | 'processing' | 'ready' | 'needs_ocr' | 'failed'
//   - needs_ocr: el PDF no tiene capa de texto (escaneado); no se extrajo contenido.
// kind: 'theory' | 'practice' | NULL (sin clasificar)
// kindSource: 'manual' (la persona eligió) | 'auto' (sugerido por el backend) | NULL
// pageCount / textPageCount: páginas del PDF y páginas con texto extraído (ver FilePage).
model File {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String
  organizationId String?       @db.Uuid
  visibility     String        @default("private")
  subjectId      String?       @db.Uuid
  name           String
  mimeType       String
  sizeBytes      Int           @default(0)
  storageUrl     String?
  storagePath    String?
  status         String        @default("uploading")
  errorMessage   String?
  kind           String?
  kindSource     String?
  kindReason     String?
  pageCount      Int?
  textPageCount  Int?
  processedAt    DateTime?     @db.Timestamp(6)
  // Indexación para RAG. indexStatus: 'pending' | 'indexing' | 'indexed' | 'failed' | 'unavailable'
  //   - unavailable: falta pgvector o su migración (ver lib/rag/vector.ts).
  // embeddingModel: modelo con el que se generaron los embeddings de sus fragmentos.
  indexStatus    String        @default("pending")
  indexError     String?
  chunkCount     Int           @default(0)
  indexedAt      DateTime?     @db.Timestamp(6)
  embeddingModel String?
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  subject        Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  documents         Document[]
  conversationLinks ConversationFile[]
  questionNodes     QuestionNode[]
  pages             FilePage[]
  chunks            FileChunk[]

  @@index([userId], map: "files_user_idx")
  @@index([subjectId], map: "files_subject_idx")
  @@index([organizationId], map: "files_org_idx")
  @@map("files")
}

// Texto extraído de un PDF, una fila por página con texto (pageNumber desde 1).
// Es la base para RAG: cada fragmento puede citar su página. Las páginas sin texto
// (escaneadas) no tienen fila: nunca se inventa contenido.
model FilePage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fileId     String   @db.Uuid
  userId     String
  pageNumber Int
  text       String
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  file       File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fileId, pageNumber], map: "file_pages_file_page_key")
  @@index([userId], map: "file_pages_user_idx")
  @@map("file_pages")
}

// Fragmento de una página para RAG. No cruza páginas, así que `pageNumber` es exacto al citar.
// userId / organizationId / visibility / subjectId copian los de su archivo: la recuperación
// los vuelve a exigir como defensa adicional a los permisos del archivo (lib/authz.ts).
// La columna `embedding vector(1536)` la crea la migración 5_pgvector y solo se usa con SQL
// (lib/rag/*): Prisma no la maneja, por eso no figura en el modelo.
model FileChunk {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fileId         String   @db.Uuid
  userId         String
  organizationId String?  @db.Uuid
  visibility     String   @default("private")
  subjectId      String?  @db.Uuid
  pageNumber     Int
  chunkIndex     Int
  content        String
  embeddingModel String?
  createdAt      DateTime @default(now()) @db.Timestamp(6)
  file           File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fileId, pageNumber, chunkIndex], map: "file_chunks_file_page_chunk_key")
  @@index([userId], map: "file_chunks_user_idx")
  @@index([subjectId], map: "file_chunks_subject_idx")
  @@map("file_chunks")
}

// kind: 'note' | 'summary'
model Document {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String
  organizationId String?       @db.Uuid
  visibility     String        @default("private")
  subjectId      String?       @db.Uuid
  sourceFileId   String?       @db.Uuid
  title          String
  kind           String        @default("note")
  contentMd      String        @default("")
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamp(6)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  subject        Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  sourceFile     File?         @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)

  @@index([userId], map: "documents_user_idx")
  @@index([subjectId], map: "documents_subject_idx")
  @@index([organizationId], map: "documents_org_idx")
  @@map("documents")
}

// Las conversaciones y sus mensajes son siempre privados de su dueño.
// mode: 'theory' | 'practice' | 'free'
model Conversation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  subjectId String?  @db.Uuid
  title     String   @default("Nueva conversación")
  mode      String   @default("free")
  /// Rama abierta por última vez; se restaura al reabrir la conversación.
  activeNodeId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  messages      Message[]
  fileLinks     ConversationFile[]
  questionNodes QuestionNode[]
  agentActions  AgentAction[]
  nodes         ConversationNode[]
  folderSources FolderSource[]

  @@index([userId], map: "conversations_user_idx")
  @@index([subjectId], map: "conversations_subject_idx")
  @@map("conversations")
}

model ConversationFile {
  conversationId String       @db.Uuid
  fileId         String       @db.Uuid
  userId         String
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  file           File         @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, fileId])
  @@index([userId], map: "conversation_files_user_idx")
  @@map("conversation_files")
}

// role: 'user' | 'assistant' | 'system'
// content: texto visible (Markdown). description: alias corto del tema (solo asistente).
// metadata: datos estructurados de la respuesta (modelo, recuperación, acciones descartadas).
model Message {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @db.Uuid
  userId         String
  role           String
  content        String
  description    String?
  metadata       Json?
  /// Rama del árbol de la conversación a la que pertenece el mensaje.
  nodeId         String?      @db.Uuid
  /// Orden global de inserción: createdAt puede repetirse dentro de una misma transacción.
  seq            BigInt       @default(autoincrement())
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  node           ConversationNode? @relation("NodeMessages", fields: [nodeId], references: [id], onDelete: SetNull)

  questionNodes QuestionNode[]
  agentActions  AgentAction[]
  anchoredNodes ConversationNode[] @relation("NodeAnchor")
  folderSources FolderSource[]

  @@index([conversationId], map: "messages_conversation_idx")
  @@index([nodeId, seq], map: "messages_node_seq_idx")
  @@index([userId], map: "messages_user_idx")
  @@map("messages")
}

// Acciones que el agente PROPONE. Nunca se ejecutan solas: pasan a 'accepted'
// únicamente cuando el usuario las confirma y el backend las revalida.
// type: 'propose_history_branch' (ampliable) · status: 'proposed' | 'accepted' | 'dismissed'
/// Árbol de ramas de UNA conversación (distinto de QuestionNode, el mapa de dudas de la materia).
/// La raíz es el único nodo sin padre; un índice único parcial (ver migración 6) lo garantiza.
model ConversationNode {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId   String    @db.Uuid
  userId           String
  parentId         String?   @db.Uuid
  /// Mensaje de la rama padre en el que se bifurcó. El hijo hereda hasta ese mensaje inclusive.
  anchorMessageId  String?   @db.Uuid
  alias            String
  topic            String
  /// Orden entre hermanos.
  position         Int       @default(0)
  /// Resumen de los mensajes PROPIOS de la rama hasta summaryUpToSeq. Nunca incluye ramas hermanas.
  contextSummary   String?
  summaryUpToSeq   BigInt?
  summaryVersion   Int       @default(0)
  summaryUpdatedAt DateTime? @db.Timestamp(6)
  /// Resumen del tramo compartido hasta la bifurcación; es inmutable, así que se calcula una sola vez.
  inheritedSummary String?
  createdAt        DateTime  @default(now()) @db.Timestamp(6)
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  conversation  Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        ConversationNode?  @relation("ConversationTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      ConversationNode[] @relation("ConversationTree")
  anchorMessage Message?           @relation("NodeAnchor", fields: [anchorMessageId], references: [id], onDelete: SetNull)
  messages      Message[]          @relation("NodeMessages")
  folderSources FolderSource[]
  
  @@index([conversationId], map: "conversation_nodes_conversation_idx")
  @@index([parentId], map: "conversation_nodes_parent_idx")
  @@index([userId], map: "conversation_nodes_user_idx")
  @@map("conversation_nodes")
}

model AgentAction {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String
  conversationId String       @db.Uuid
  messageId      String       @db.Uuid
  type           String
  payload        Json
  status         String       @default("proposed")
  resultNodeId   String?      @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  resolvedAt     DateTime?    @db.Timestamp(6)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId], map: "agent_actions_user_idx")
  @@index([conversationId], map: "agent_actions_conversation_idx")
  @@index([messageId], map: "agent_actions_message_idx")
  @@map("agent_actions")
}

// Nodos del mapa conceptual: cada duda es un nodo; `parentId` arma el árbol.
// status: 'open' | 'resolved'
model QuestionNode {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String
  subjectId      String?       @db.Uuid
  conversationId String?       @db.Uuid
  messageId      String?       @db.Uuid
  fileId         String?       @db.Uuid
  parentId       String?       @db.Uuid
  question       String
  answerSummary  String?
  status         String        @default("open")
  posX           Float         @default(0) @db.Real
  posY           Float         @default(0) @db.Real
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamp(6)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject        Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  file           File?         @relation(fields: [fileId], references: [id], onDelete: SetNull)
  parent         QuestionNode? @relation("QuestionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       QuestionNode[] @relation("QuestionTree")

  @@index([userId], map: "question_nodes_user_idx")
  @@index([subjectId], map: "question_nodes_subject_idx")
  @@index([parentId], map: "question_nodes_parent_idx")
  @@map("question_nodes")
}

// --- Carpeta: grafo de conocimiento por workspace ---------------------------
// Distinto del árbol de ramas del historial (ConversationNode): un apunte puede recibir
// referencias de muchas sesiones y ramas mediante FolderSource, sin compartir estructura.
// subjectId NULL = workspace General (mismo criterio que File y Document).
// kind: 'concept' | 'key_points' | 'exercise' | 'solution' | 'note'
model FolderNode {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  subjectId String?  @db.Uuid
  kind      String   @default("concept")
  title     String
  /// Contenido en Markdown.
  content   String   @default("")
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamp(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  outgoing FolderEdge[]   @relation("EdgeFrom")
  incoming FolderEdge[]   @relation("EdgeTo")
  sources  FolderSource[]

  @@index([userId, subjectId], map: "folder_nodes_user_subject_idx")
  @@map("folder_nodes")
}

// kind: 'child' (from contiene a to; el grafo no admite ciclos) | 'related' (simétrica; se guarda con from < to)
model FolderEdge {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  fromId    String     @db.Uuid
  toId      String     @db.Uuid
  kind      String
  createdAt DateTime   @default(now()) @db.Timestamp(6)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  from      FolderNode @relation("EdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        FolderNode @relation("EdgeTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, kind], map: "folder_edges_unique_key")
  @@index([toId], map: "folder_edges_to_idx")
  @@index([userId], map: "folder_edges_user_idx")
  @@map("folder_edges")
}

/// Referencia explícita de un apunte al historial que lo justifica. Las claves al historial son
/// SET NULL: si la conversación se borra, el apunte conserva `label` y la referencia queda inactiva.
model FolderSource {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId         String            @db.Uuid
  userId         String
  conversationId String?           @db.Uuid
  messageId      String?           @db.Uuid
  historyNodeId  String?           @db.Uuid
  label          String
  createdAt      DateTime          @default(now()) @db.Timestamp(6)
  node           FolderNode        @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message        Message?          @relation(fields: [messageId], references: [id], onDelete: SetNull)
  historyNode    ConversationNode? @relation(fields: [historyNodeId], references: [id], onDelete: SetNull)

  @@index([nodeId], map: "folder_sources_node_idx")
  @@index([conversationId], map: "folder_sources_conversation_idx")
  @@index([userId], map: "folder_sources_user_idx")
  @@map("folder_sources")
}
